---
import BaseLayout from "../layouts/BaseLayout.astro";

const linkedInUrl = "https://www.linkedin.com/in/nambi-ezhilarasu-2928421b3/";
// TODO: Replace this placeholder with the preferred public contact address.
const contactEmail = "your-email@example.com";
const siteUrl = Astro.site ?? new URL("https://nambi-ezhilarasu.vercel.app");
const personJsonLd = JSON.stringify({
  "@context": "https://schema.org",
  "@type": "Person",
  name: "Nambi Ezhilarasu",
  jobTitle: "Functional Safety Engineer",
  description:
    "Functional Safety Engineer working on ISO 26262 and ASPICE in automotive, with earlier experience in HIL validation and vehicle validation.",
  url: new URL("/about/", siteUrl).href,
  sameAs: [linkedInUrl],
  worksFor: {
    "@type": "Organization",
    name: "Drivvize",
  },
}).replace(/</g, "\\u003c");
---

<BaseLayout
  title="About Nambi Ezhilarasu - Functional Safety Engineer"
  description="About Nambi Ezhilarasu, Functional Safety Engineer. Career timeline across HIL validation, vehicle validation and ISO 26262 functional safety."
  structuredData={personJsonLd}
>
  <section class="simple-page about-page">
    <p class="eyebrow"><span class="eyebrow-line"></span> CAREER TIMELINE</p>
    <h1>Nambi Ezhilarasu<span>.</span></h1>
    <p class="about-intro">
      I'm a Functional Safety Engineer working on ISO 26262 and ASPICE in automotive. My earlier work covered HIL
      validation, BEV vehicle validation and HEV functional safety.
    </p>
    <p class="about-links">
      <a href={linkedInUrl} target="_blank" rel="noopener noreferrer">
        LinkedIn <span aria-hidden="true">↗</span>
      </a>
      <a href={`mailto:${contactEmail}`}>Email</a>
    </p>
    <!-- TODO: Replace the placeholder contact email above. -->

    <div class="timeline-heading">
      <h2>Career timeline</h2>
      <span>CAREER / 2023—NOW</span>
    </div>

    <ol class="career-timeline" aria-label="Career timeline">
      <li class="career-stop">
        <span class="career-stop-number" aria-hidden="true">01</span>
        <article class="career-card">
          <div class="career-card-top">
            <p class="career-period">
              <time datetime="2023-05">MAY 2023</time>
              <span aria-hidden="true">—</span>
              <time datetime="2024-05">MAY 2024</time>
            </p>
            <span class="career-status">ROLE 01</span>
          </div>
          <h3>Tata Elxsi</h3>
          <p class="career-role">HIL Validation Engineer</p>
        </article>
      </li>

      <li class="career-stop">
        <span class="career-stop-number" aria-hidden="true">02</span>
        <article class="career-card">
          <div class="career-card-top">
            <p class="career-period">
              <time datetime="2024-05">MAY 2024</time>
              <span aria-hidden="true">—</span>
              <time datetime="2025-05">MAY 2025</time>
            </p>
            <span class="career-status">ROLE 02</span>
          </div>
          <h3>Mahindra &amp; Mahindra Ltd.</h3>
          <p class="career-employer-note">Deputed by Tata Elxsi</p>
          <div class="career-roles">
            <p><span>BEV</span> Vehicle Validation Engineer</p>
            <p><span>HEV</span> Functional Safety Engineer</p>
          </div>
        </article>
      </li>

      <li class="career-stop is-current">
        <span class="career-stop-number" aria-hidden="true">03</span>
        <article class="career-card">
          <div class="career-card-top">
            <p class="career-period">
              <time datetime="2025-06">JUNE 2025</time>
              <span aria-hidden="true">—</span>
              <span>PRESENT</span>
            </p>
            <span class="career-status">CURRENT ROLE</span>
          </div>
          <h3>Drivvize</h3>
          <p class="career-role">Functional Safety Engineer</p>
        </article>
      </li>
    </ol>
  </section>
</BaseLayout>
