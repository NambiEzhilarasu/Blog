---
import "../styles/global.css";

interface Props {
  title?: string;
  description?: string;
  ogType?: "website" | "article";
  image?: string;
  imageAlt?: string;
  publishedAt?: Date;
  structuredData?: string;
  noIndex?: boolean;
}

const {
  title = "Nambi Ezhilarasu - Articles",
  description = "Articles on Functional Safety, ISO 26262, ASPICE and automotive R&D by Nambi Ezhilarasu.",
  ogType = "website",
  image,
  imageAlt,
  publishedAt,
  structuredData,
  noIndex = false,
} = Astro.props;
const currentPath = Astro.url.pathname;
const normalizedPath = currentPath.replace(/\/+$/, "") || "/";
const isArticlesPage = normalizedPath === "/" || normalizedPath.startsWith("/articles/");
const siteUrl = Astro.site ?? new URL("https://nambi-ezhilarasu.vercel.app");
const canonicalUrl = new URL(currentPath, siteUrl);
// TODO: Replace with a dedicated 1200x630 social-preview image when available.
const defaultOgImage = "/images/articles/asil-a-hw-metrics.png";
const ogImageUrl = new URL(image ?? defaultOgImage, siteUrl);
const ogImageAlt = imageAlt ?? (image ? title : "Flowchart for selecting ASIL A safety mechanisms.");
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="theme-color" content="#ffffff" />
    <meta name="description" content={description} />
    <title>{title}</title>
    <link rel="canonical" href={canonicalUrl.href} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content={ogType} />
    <meta property="og:url" content={canonicalUrl.href} />
    <meta property="og:image" content={ogImageUrl.href} />
    <meta property="og:image:alt" content={ogImageAlt} />
    {ogType === "article" && publishedAt && (
      <meta property="article:published_time" content={publishedAt.toISOString()} />
    )}
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImageUrl.href} />
    {noIndex && <meta name="robots" content="noindex,nofollow" />}
    <link
      rel="alternate"
      type="application/rss+xml"
      title="Nambi Ezhilarasu - Articles"
      href="/rss.xml"
    />
    {structuredData && (
      <script type="application/ld+json" set:html={structuredData} />
    )}
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin="anonymous" />
    <link
      href="https://fonts.googleapis.com/css2?family=DM+Mono:wght@400;500&family=Manrope:wght@400;500;600;700;800&display=swap"
      rel="stylesheet"
    />
  </head>
  <body>
    <a class="skip-link" href="#main-content">Skip to content</a>
    <div class="site-shell">
      <header class="site-header">
        <a class="wordmark" href="/" aria-label="NE. Nambi Ezhilarasu home">
          <span class="wordmark-mark">NE<span>.</span></span>
          <span class="wordmark-name">Nambi Ezhilarasu</span>
        </a>
        <nav class="site-nav" aria-label="Main navigation">
          <a
            class:list={["nav-link", { active: isArticlesPage }]}
            href="/"
            aria-current={isArticlesPage ? "page" : undefined}
          >Articles</a>
          <a
            class:list={["nav-link", { active: normalizedPath === "/about" }]}
            href="/about/"
            aria-current={normalizedPath === "/about" ? "page" : undefined}
          >About</a>
        </nav>
        {isArticlesPage && (
          <span class="header-index">ARTICLES <span class="status-dot" aria-hidden="true"></span></span>
        )}
      </header>

      <main id="main-content" tabindex="-1">
        <slot />
      </main>

      <footer class="site-footer">
        <a class="footer-name" href="/">Nambi Ezhilarasu<span>.</span></a>
        <span class="footer-note">Personal technical notes. Views are my own and do not represent my employer.</span>
        <span class="footer-coordinates">VOL. 01</span>
      </footer>
    </div>
  </body>
</html>
