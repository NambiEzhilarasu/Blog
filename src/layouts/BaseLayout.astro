---
import "../styles/global.css";

interface Props {
  title?: string;
  description?: string;
}

const {
  title = "Nambi Ezhilarasu — Technical Journal",
  description = "Technical articles and notes by Nambi Ezhilarasu.",
} = Astro.props;
const currentPath = Astro.url.pathname;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="theme-color" content="#101113" />
    <meta name="description" content={description} />
    <title>{title}</title>
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin="anonymous" />
    <link
      href="https://fonts.googleapis.com/css2?family=DM+Mono:wght@400;500&family=Manrope:wght@400;500;600;700;800&display=swap"
      rel="stylesheet"
    />
  </head>
  <body>
    <div class="site-shell">
      <header class="site-header">
        <a class="wordmark" href="/" aria-label="Nambi Ezhilarasu home">
          <span class="wordmark-mark">NE<span>.</span></span>
          <span class="wordmark-name">Nambi Ezhilarasu</span>
        </a>
        <nav class="site-nav" aria-label="Main navigation">
          <a class:list={["nav-link", { active: currentPath === "/" }]} href="/">Journal</a>
          <a class:list={["nav-link", { active: currentPath === "/about/" }]} href="/about/">About</a>
        </nav>
        <span class="header-index">TECH JOURNAL <span class="status-dot"></span></span>
      </header>

      <main>
        <slot />
      </main>

      <footer class="site-footer">
        <a class="footer-name" href="/">Nambi Ezhilarasu<span>.</span></a>
        <span class="footer-note">Independent technical journal</span>
        <span class="footer-coordinates">VOL. 01</span>
      </footer>
    </div>
  </body>
</html>
